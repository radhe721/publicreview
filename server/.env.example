PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=ideapulse_development_jwt_secret_key_minimum_32_characters_random
DATABASE_PATH=./src/db/ideapulse.db

# Public URL of this API (OAuth callbacks are built from it). Locally: http://localhost:5001
SERVER_URL=http://localhost:5001

# OAuth sign-in (leave blank to hide the button)
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
#   Authorized redirect URI: <SERVER_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL: <SERVER_URL>/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: any GitHub token (no scopes needed) so repo sharing isn't capped at 60 lookups/hour
GITHUB_TOKEN=

# Transactional email for password reset links (https://resend.com). Without a key, the link is
# logged to the server console in development; production refuses to send.
RESEND_API_KEY=
MAIL_FROM=BusinessListe <no-reply@yourdomain.com>
