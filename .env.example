# ==========================================
# BusinessListe Environment Variables Configuration
# ==========================================

# Server Port
PORT=5001

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Exact origin(s) of the frontend, comma-separated. Only these may make logged-in API requests.
# Single-origin deploy (API serves the client): set to your own domain, e.g. https://businessliste.com
CLIENT_URL=http://localhost:5173

# Public URL of the API server; OAuth callback URLs are built from it.
SERVER_URL=http://localhost:5001

# Secret for signing session tokens. REQUIRED in production: 32+ random chars, the server refuses
# to start otherwise. Generate one with: openssl rand -hex 32
JWT_SECRET=

# ------------------------------------------
# OAuth sign-in (leave blank to hide the button)
# ------------------------------------------
# Google: console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
#   Authorized redirect URI: <SERVER_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers -> New OAuth App
#   Authorization callback URL: <SERVER_URL>/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: any GitHub token (no scopes needed) so repo sharing isn't capped at 60 lookups/hour
GITHUB_TOKEN=

# ------------------------------------------
# Email (password reset links) via https://resend.com
# ------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
MAIL_FROM=BusinessListe <no-reply@yourdomain.com>

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Option 1: Turso Cloud Database (Recommended for Production)
TURSO_DATABASE_URL=libsql://your-turso-db.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Option 2: Local SQLite file (Fallback if Turso is not set)
# DATABASE_PATH=./src/db/ideapulse.db

# Payments (Stripe Checkout). Leave empty to show paid features as "coming soon".
# Webhook endpoint to add in Stripe: https://<your-domain>/api/v1/payments/webhook (event: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Free plan: published ideas per 30 days (Pro is unlimited).
FREE_IDEAS_PER_MONTH=5
