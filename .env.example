# ==========================================
# IdeaPulse Environment Variables Configuration
# ==========================================

# Server Port
PORT=5001

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# Client origin for CORS (Set to your production domain or leave blank if using single-origin)
CLIENT_URL=http://localhost:5173

# Secret key used for signing JWT auth tokens (must be at least 32 characters in production)
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_for_security_12345

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# Option 1: Turso Cloud Database (Recommended for Production)
TURSO_DATABASE_URL=libsql://your-turso-db.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Option 2: Local SQLite file (Fallback if Turso is not set)
# DATABASE_PATH=./src/db/ideapulse.db
